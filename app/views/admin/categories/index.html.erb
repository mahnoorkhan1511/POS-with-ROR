<div class="overflow-y-auto">
  <div class="flex flex-row justify-between ">
    
    <h1 class="text-gray-500 text-2xl font-semibold p-5">Categories</h1>
    <%= link_to "Add a category ",new_admin_category_path, data: { turbo_frame: "add_category"}, class: "block bg-teal-700 py-6 px-4 text-white  hover:bg-teal-900 rounded-md text-md font-semibold" %>
  </div>
  <% if @categories.any? %>
    <table class="table-auto min-w-full">
      
      <thead class=" p-6  ">
        <tr class="p-6 border-b border-gray-400 text-center text-gray-900">
          
          <th  class="px-4 py-2 font-medium text-center">Name</th>
          <th  class="px-4 py-2 font-medium text-center">Number of Products</th>
        </tr>
      </thead>
      <tbody>
        <% @categories.each do |category|%>
          <tr class="border-b border-gray-200">
            
            <td class="px-6 py-4 text-center"><%= category.name %></td>
            <td class="px-6 py-4 text-center"><%= category.products.size%></td>
            <td>
              <%= button_to [:admin, category], method: :delete, data: {turbo_confirm: "Do you really want to delete #{category.name}? You will be deleting the related products aswell." }, class:'text-red-600 hover:text-red-800 text-center p-3 py-6' do %>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-7">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                </svg>
              <% end%>
            </td>
          </tr>
        <%end%>
      </tbody>
    </table>
    <% else %>
      <h1 class="text-sky-900 text-2xl font-bold p-5 opacity-50">No Category available, table is empty</h1>
    <% end %>
</div>
<%= turbo_frame_tag "add_category" %>