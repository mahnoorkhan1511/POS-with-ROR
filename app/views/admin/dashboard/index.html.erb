
  <!-- Bottom big row -->
  <div class="h-5/6 bg-white flex flex-col rounded-xl overflow-y-auto max-h-screen p-4  mt-4">
    <!-- profits and graphs -->
    <p class="p-5 font-bold text-3xl">Stats</p>
        <div class="flex flex-wrap justify-between px-20 pt-5  h-1/2 gap-4">
            <div class="max-h-80 aspect-[4/3] bg-slate-100 rounded-xl shadow p-4 w-full md:w-[48%] ">
                <%# <%= line_chart [{ name: "Daily Profit", data: { '2025-04-01' => 10, '2025-04-02' => 20, '2025-04-03' => 15 } }], width: "100%", height: "100%"%> 
                <%= area_chart [{name: "Daily Profit" ,data:@daily_profit_data}] %>
            </div>

            <div class="max-h-80 aspect-[4/3] bg-slate-100 rounded-xl shadow p-4 w-full md:w-[48%]">
                <%= area_chart [{name: "Monthly" ,data:@monthly_profit_data}] %>

            </div>
        </div>
      <!-- Top products  -->
      <p class="p-5 font-bold text-3xl">Top Selling Products </p>
      <div class="container px-10  max-w-screen ">
        <div class="grid grid-cols-3 gap-4 ">
          <% @products.each do |item|%>
            <% pro = item[:product]%>
            <% count = item[:count]%>
            <div class="relative max-w-sm h-80 rounded-md  shadow-lg" >
              <%= image_tag pro.featured_image, class: "rounded-t-md w-full h-50" %>
              <div class="px-4 h-20 flex flex-col  sm:h-auto sm:py-4 sm:px-2 md:h-auto md:px-2 md:px-6 md:py-2">
                  
                  <div class="font-bold text-md md:text-lg lg:text-xl mb-1 w-sm">
                    <%= pro[:name]%>
                  </div>
                  <p class="text-gray-900 text-xs md:text-sm overflow-hidden text-ellipsis">
                    <%= pro.description %>
                  </p>
              </div>
              <div class="absolute bottom-0 right-0 pr-2 pb-2">
                <span class="inline-block bg-blue-100 text-blue-800 text-sm rounded p-1 px-3">
                    <%= count%>
                </span> 
              </div>
            </div>
          <% end %>
           
        </div>
      </div>

    </div>
