<div class="flex flex-col p-6 px-18">
  <p class="text-2xl font-semibold text-gray-600 p-10 mt-10 ">
    Your Orders 
  </p>
  <div class="flex flex-col">
    <% @orders.each do |o|%>
      <div class="flex flex-row justify-between px-8 rounded-sm bg-gray-100 py-5">
        <p>Order No. <%= o.id%></p>
        <p>Status: <%= o.status.capitalize%></p>
      </div>
      <div id="order-details-<%=o.id%>" class="mb-5"></div>
    <% end%>
  </div>
</div>