<%= turbo_frame_tag "show_order" do %>
	<div data-controller="modal" 
    data-action="click->modal#close"
    data-modal-target="background" class= "fixed inset-0 backdrop-blur flex justify-center items-center z-50 text-black ">
    <div data-modal-target="content" class="bg-white p-6 rounded-lg shadow-lg w-full max-w-3xl ">
			<div class="flex flex-col items-center">
				<div class="flex flex-col pt-20 pb-6 text-center items-center">
						
          <div class="text-green-500">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-10">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
            </svg>
          </div>
          <p class="font-md text-2xl">
            Thank you! 
            <br>
            Your order has been recieved
          </p>
				</div>
				<div class="w-1/2 bg-slate-200 flex flex-col rounded-md p-3">
					
          <p class="text-lg my-3 font-semibold">
						Order Details
					</p>
					<div class="flex flex-row justify-between">
						<div class="flex flex-col font-medium">
							
              <p>Order Number:</p>
							<p>Order Status:</p>
							<p>Date:</p>
							<p>Payment Method</p>
							<p>Payment Status</p>
							<p>Amount</p>
						</div>
						<div class="flex flex-col text-right">
							
              <p><%= @order.id %></p>
							<p><%= @order.status%></p>
							<p><%= @order.created_at.to_date%></p>
							<p><%= @order.payment_type%></p>
							<p>
								<% if @order.is_paid%>
									Paid
								<% else %>
									Unpaid
								<%end %>
							</p>
							<p><%= @order.amount%></p>
						</div>
					</div>
				</div>
				<div class="flex flex-col p-3 w-1/2 border-b border-slate-200">
					
          <p class="text-lg my-3 font-semibold ">
						Products
					</p>
					<% @order.ordered_products.each do |op|%>
						<div class="flex flex-row justify-between items-center">
							<div class="flex flex-row items-center gap-2" >
								
                <%= image_tag op.featured_image, class:'h-13 w-13 rounded-xl' if op.featured_image.attached? %>
								<div class="flex flex-row gap-3">
									
									<p class="font-medium">
										<%= op.quantity%> x
									</p>
									<%= op.name %>
								</div>
							</div>
							<%= op.price%>
						</div>
					<%end%>
				</div>
			</div>
		</div>
	</div>
<%end%>