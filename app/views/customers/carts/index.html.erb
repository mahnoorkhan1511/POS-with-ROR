            </g>
          </svg>

        </div>
      <%end%>
    </div>
    
  </div>
  <div class="flex flex-col bg-white w-1/4 py-50 px-10">
    
    <p class="text-2xl font-medium pb-4">
      SUMMARY
    </p>
    <%if @products_to_order.empty?%>
      <p class=" text-lg"> Sorry bro, you gotta add something in the bag first. </p>
    <%else%>
      <table class="border-b border-gray-200">
        <tbody >
          <% @products_to_order.each do |pic|%>
            <tr class="flex flex-row justify-between">
              <td class="text-slate-800 py-2 ">
                <%= pic.product_name.titleize %>
              </td>
              <td class="text-slate-500 py-2  text-right">
                <%= pic.total %>
              </td>
            </tr>
          <%end%>
        </tbody>
      </table>
      <div class="flex flex-row justify-between">
        
        <p class="font-bold">TOTAL:</p>
        <%= @cart.total%>
      </div>
      <%=link_to "CHECKOUT", new_customers_order_path ,class: "bg-slate-700 w-50 h-8 text-center py-1 text-white rounded font-semibold mx-23 my-8"%>
    <%end%>
  </div>
</div>